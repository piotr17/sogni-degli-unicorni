<header class="site-head">
  <div class="shell site-head__inner">
    <a href="/" class="brand" {% if page.url == '/' %}aria-current="page"{% endif %}>
      <span class="brand__mark" aria-hidden="true">{% include "svg/unicorn-mark.svg" %}</span>
      <span>{{ meta.siteName }}<small>Storie e disegni per la buonanotte</small></span>
    </a>

    <button class="button nav-toggle" type="button" aria-expanded="false" aria-controls="mainnav">Menu</button>

    <nav id="mainnav" class="nav" aria-label="Principale">
      <ul>
        {%- for item in navigation.top %}
        <li>
          <a href="{{ item.url }}"{% if item.highlight %} class="button button--burro"{% endif %}{{ helpers.getLinkActiveState(item.url, page.url) | safe }}>{{ item.text }}</a>
        </li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
