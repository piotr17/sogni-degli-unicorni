---
layout: base
---
<header class="page-head page-head--menta">
  <div class="shell">
    {% include "partials/breadcrumb.njk" %}
    <span class="kicker">{{ collections.disegni.length }} disegni · gratis</span>
    <h1>{{ title }}</h1>
    {%- if lede %}<p>{{ lede }}</p>{% endif %}
  </div>
</header>

<section class="section">
  <div class="shell">
    <ul class="cards">
      {%- for drawing in collections.disegni | reverse %}{% set eager = loop.index <= 3 %}{% include "partials/coloring-card.njk" %}{% endfor %}
    </ul>
    <p class="kicker" style="margin-top:var(--space-l)"><a href="/uso-dei-disegni/">Come puoi usare i disegni (casa, scuola, asilo) →</a></p>
  </div>
</section>
