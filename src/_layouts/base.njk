<!DOCTYPE html>
<html lang="{{ meta.lang }}">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {% include "partials/seo.njk" %}

    <link rel="preload" href="/assets/fonts/fraunces/fraunces-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/assets/fonts/atkinson/atkinson-next-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/assets/css/global.css?v={{ build.version }}" />
    <meta name="p:domain_verify" content="322e76a5fc0efd6fbec8100a5054513a" />

    <!-- Consent Mode v2: tutto negato finché il visitatore non sceglie nel banner di Google
         (Privacy e messaggi di AdSense), che aggiorna questi valori da solo. Deve stare prima di GTM. -->
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500
      });
      gtag('set', 'ads_data_redaction', true);
    </script>
    <!-- Google Tag Manager -->
    <script>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({'gtm.start': new Date().getTime(), event: 'gtm.js'});
        var f = d.getElementsByTagName(s)[0], j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-MK8MX85');
    </script>
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4548604400396789" crossorigin="anonymous"></script>
  </head>

  <body>
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MK8MX85" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <a href="#main" class="skip-link">{{ meta.skipContent }}</a>

    {% include "partials/header.njk" %}
    <main id="main">{{ content | safe }}</main>
    {% include "partials/footer.njk" %}

    <script>
      // menu mobile
      (function () {
        var toggle = document.querySelector('.nav-toggle');
        var nav = document.getElementById('mainnav');
        if (!toggle || !nav) return;
        toggle.addEventListener('click', function () {
          var open = toggle.getAttribute('aria-expanded') !== 'true';
          toggle.setAttribute('aria-expanded', open);
          nav.dataset.open = open;
        });
      })();
      // email anti-spam: l'indirizzo si compone solo al clic
      document.addEventListener('click', function (e) {
        var link = e.target.closest('a.email');
        if (!link) return;
        e.preventDefault();
        window.location.href = 'mailto:' + link.dataset.e.split('').reverse().join('');
      });
      // riapre il banner del consenso di Google (Privacy e messaggi di AdSense)
      document.addEventListener('click', function (e) {
        if (!e.target.closest('[data-consent]')) return;
        e.preventDefault();
        window.googlefc = window.googlefc || {};
        window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
        window.googlefc.callbackQueue.push(function () { window.googlefc.showRevocationMessage(); });
      });
      {%- if temp is defined %}
      // temperatura di generazione della storia, letta da GA4
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({tempValue: '{{ temp }}'});
      {%- endif %}
    </script>
  </body>
</html>
