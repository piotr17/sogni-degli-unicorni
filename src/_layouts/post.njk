---
layout: base
---
{%- set relatedColoring = collections.posts | relatedColoring({ fileSlug: page.fileSlug, data: { title: title } }) -%}
{%- set neighbours = collections.storie | storyNeighbours(page.url) -%}

<article class="story">
  <header class="article-head">
    <div class="shell">
      {% include "partials/breadcrumb.njk" %}
      <span class="kicker">Storia della buonanotte</span>
      <h1>{{ title | plainText }}</h1>
      {%- if description %}<p class="lede">{{ description | plainText }}</p>{% endif %}
      <ul class="chips" aria-label="Informazioni sulla storia">
        <li class="chip"><time datetime="{{ page.date | toIsoString }}">{{ page.date | formatDate('D MMMM YYYY') }}</time></li>
        <li class="chip">{{ content | readingMinutes }} min ad alta voce</li>
        {%- if style %}<li class="chip">Nello stile di {{ style }}</li>{% endif %}
      </ul>
    </div>
  </header>

  <div class="shell">
    {%- if image %}
    <figure class="article-cover frame">
      <img src="{{ image }}" alt="Illustrazione della storia {{ title | plainText }}" width="1024" height="1024" fetchpriority="high" />
    </figure>
    {%- endif %}

    <div class="prose">{{ content | demoteHeadings | safe }}</div>
    <p class="end-mark" aria-hidden="true">✦ ✦ ✦</p>

    {%- if relatedColoring %}
    <aside class="callout no-print" aria-labelledby="coloring-title">
      <img src="{{ relatedColoring.data.image }}" alt="" width="144" height="144" loading="lazy" />
      <div>
        <span class="kicker">Dopo la storia</span>
        <h2 id="coloring-title">Colora {{ title | plainText }}</h2>
        <p>Il disegno di questa storia, gratis e pronto da stampare.</p>
        <a class="button button--ink" href="{{ relatedColoring.url }}">Vai al disegno da colorare →</a>
      </div>
    </aside>
    {%- endif %}

    <nav class="pager no-print" aria-label="Altre storie">
      {%- if neighbours.prev %}<a class="prev" href="{{ neighbours.prev.url }}" rel="prev"><span>← Storia precedente</span><b>{{ neighbours.prev.data.title | plainText }}</b></a>{% endif %}
      {%- if neighbours.next %}<a class="next" href="{{ neighbours.next.url }}" rel="next"><span>Storia successiva →</span><b>{{ neighbours.next.data.title | plainText }}</b></a>{% endif %}
    </nav>
  </div>
</article>

<section class="section no-print">
  <div class="shell">
    <div class="section-head">
      <div>
        <span class="kicker">Se ti è piaciuta</span>
        <h2>Altre storie per stasera</h2>
      </div>
      <a class="button" href="/storie/">Tutte le storie →</a>
    </div>
    <ul class="cards">
      {%- for story in collections.storie | relatedStories(page.url, 3) %}{% include "partials/story-card.njk" %}{% endfor %}
    </ul>
  </div>
</section>

{% include "partials/book-band.njk" %}
