---
layout: base
---
<header class="page-head page-head--rosa">
  <div class="shell">
    {% include "partials/breadcrumb.njk" %}
    <span class="kicker">{{ collections.storie.length }} storie</span>
    <h1>{{ title }}</h1>
    {%- if lede %}<p>{{ lede }}</p>{% endif %}
  </div>
</header>

<section class="section">
  <div class="shell">
    <ul class="cards">
      {%- for story in collections.storie | reverse %}{% include "partials/story-card.njk" %}{% endfor %}
    </ul>
  </div>
</section>

{% include "partials/book-band.njk" %}
