---
layout: base
---
<article>
  <header class="page-head page-head--cielo">
    <div class="shell">
      {% include "partials/breadcrumb.njk" %}
      <span class="kicker">Recensione{% if stars %} · <span class="stars" aria-label="{{ stars }} stelle su 5">{% for i in range(1, 6) %}{{ '★' if i <= stars else '☆' }}{% endfor %}</span>{% endif %}</span>
      <h1>{{ title }}</h1>
      {%- if description %}<p>{{ description }}</p>{% endif %}
    </div>
  </header>
  <div class="shell section">
    {%- if coverImage or image %}
    <figure class="article-cover frame"><img src="{{ coverImage or image }}" alt="{{ title }}" loading="lazy" /></figure>
    {%- endif %}
    {%- if affiliateLink %}
    <p style="margin-bottom:var(--space-l)"><a class="button button--burro" href="{{ affiliateLink }}" target="_blank" rel="sponsored noopener">Acquista su {{ affiliateName or 'Amazon' }} →</a></p>
    {%- endif %}
    <div class="prose">{{ content | demoteHeadings | safe }}</div>
    <p style="margin-top:var(--space-l)"><a class="button" href="/recensioni/">Tutte le recensioni →</a></p>
  </div>
</article>
