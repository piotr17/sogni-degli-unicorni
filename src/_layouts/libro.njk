---
layout: base
---
<article>
  <header class="page-head page-head--burro">
    <div class="shell">
      {% include "partials/breadcrumb.njk" %}
      <div class="hero__grid">
        <div>
          <span class="kicker">Il libro · {{ price }}</span>
          <h1>{{ title }}</h1>
          {%- if description %}<p>{{ description }}</p>{% endif %}
          <div class="button-row" style="margin-top:var(--space-l)">
            <a class="button button--ink" href="{{ purchaseUrl }}" rel="sponsored noopener" target="_blank">Acquista su Amazon →</a>
            <a class="button" href="/storie/">Leggi qualche storia gratis</a>
          </div>
        </div>
        <div class="hero__art">
          <span class="sticker">17 storie + 17 disegni</span>
          <img class="book-band__cover" style="width:100%" src="{{ image }}" alt="Copertina di {{ title }}" width="240" height="342" fetchpriority="high" />
        </div>
      </div>
    </div>
  </header>

  <div class="shell section">
    <div class="prose">{{ content | demoteHeadings | safe }}</div>
    <div class="button-row" style="margin-top:var(--space-l)">
      <a class="button button--ink" href="{{ purchaseUrl }}" rel="sponsored noopener" target="_blank">Acquista su Amazon · {{ price }}</a>
    </div>
  </div>
</article>
