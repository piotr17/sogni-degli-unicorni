---
layout: base
---

<!-- Schema.org per pagine da colorare -->
{% include "schemas/coloring-schema.njk" %}

<article class="region coloring-page" itemscope itemtype="https://schema.org/CreativeWork">
  <div class="wrapper flow prose">
    
    <!-- Header della pagina da colorare -->
    <header class="coloring-header">
      <h1 class="gradient-text coloring-title" itemprop="name">{{ title }} da colorare</h1>
      
      <!-- Meta informazioni -->
      <div class="coloring-meta">
        <span class="coloring-type">🎨 Disegno da colorare</span>
        <span class="coloring-age">👶 Età: 3-10 anni</span>
        <span class="coloring-difficulty">⭐ Difficoltà: Facile</span>
      </div>
      
      <!-- Descrizione -->
      {% if description %}
        <div class="coloring-description" itemprop="description">
          <p>{{ description }}</p>
        </div>
      {% endif %}
    </header>

    <!-- Immagine da colorare -->
    <figure class="coloring-image">
      <img src="{{ image }}" alt="{{ title }} da colorare - Disegno per bambini" loading="lazy" itemprop="image" />
      <figcaption>🖨️ Clicca sull'immagine per ingrandirla e stamparla</figcaption>
    </figure>

    <!-- Contenuto -->
    <div class="coloring-content" itemprop="text">
      {{ content | safe }}
    </div>

    <!-- Collegamento al racconto -->
    {% set relatedStory = collections.posts | relatedStory({ fileSlug: page.fileSlug, data: { title: title, storia: storia } }) %}

    {% if relatedStory %}
    <div class="story-link">
      <h3>📚 Leggi anche la storia!</h3>
      <p>Questo disegno è ispirato al racconto <strong>{{ title }}</strong>. Vuoi leggere la storia completa?</p>
      <a href="{{ relatedStory.url }}" class="btn btn-story">Leggi "{{ relatedStory.data.title }}"</a>
    </div>
    {% else %}
    <div class="story-link">
      <h3>📚 Scopri le nostre storie!</h3>
      <p>Esplora il magico mondo degli unicorni con i nostri racconti.</p>
      <a href="/storie/" class="btn btn-story">Tutte le storie</a>
    </div>
    {% endif %}

    <!-- Istruzioni per colorare -->
    <div class="coloring-instructions">
      <h3>🎨 Come colorare:</h3>
      <ol>
        <li>Clicca sull'immagine per ingrandirla</li>
        <li>Salva l'immagine sul tuo dispositivo</li>
        <li>Stampala su carta bianca</li>
        <li>Usa i tuoi colori preferiti per dare vita al disegno!</li>
      </ol>
    </div>

    <!-- Footer con CTA -->
    <footer class="coloring-footer">
      <div class="coloring-cta">
        <p>✨ <strong>Ti piace colorare?</strong> Scopri altri disegni magici!</p>
        <a href="/unicorni-da-colorare/" class="btn btn-secondary">Altri disegni da colorare</a>
      </div>
    </footer>

  </div>
</article>
